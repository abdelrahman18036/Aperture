{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "Turborepo shim for the Django backend. The real manifest is pyproject.toml.",
  "scripts": {
    "dev": "uv run uvicorn config.asgi:application --reload --port 8000",
    "worker": "uv run celery -A config worker --loglevel=info --pool=solo",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "check-types": "uv run mypy .",
    "test": "uv run pytest -q",
    "schema": "uv run manage.py spectacular --file ../../packages/api-client/openapi.json --format openapi-json --validate --fail-on-warn"
  }
}
