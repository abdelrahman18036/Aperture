{
  "name": "aperture",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "generate": "pnpm --filter @repo/api schema && pnpm --filter @repo/api-client generate",
    "verify:api-client": "pnpm generate && git diff --exit-code -- packages/api-client"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  }
}
