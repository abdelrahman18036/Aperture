# Aperture — environment.
#
# Copy to .env.local and adjust. .env.local is git-ignored; this file is
# committed and must stay complete. No secrets in code, ever.
#
# Every variable below has a development default in the code, so a clean clone
# runs after `docker compose up` with no .env.local at all. Production must set
# all of them.

# ---------------------------------------------------------------------------
# Django — apps/api (the API process and the Celery worker share this)
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-use-outside-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# Host port 5433, not 5432 — a native postgresql-x64-17 Windows service holds
# 5432 on this machine and has nothing to do with this project. Inside the
# compose network it is still postgres:5432. See docs/VERSIONS.md.
DATABASE_URL=postgres://app:devpassword@localhost:5433/aperture

# Cache, Celery broker, and the pub/sub bus between Django and the gateway.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Origins allowed to post a CSRF-protected form, and to make credentialed
# cross-origin calls. Both should be near-irrelevant in practice: the Next.js
# rewrite makes the browser same-origin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Distinct per process that mints IDs. Two processes sharing a node id can
# produce the same snowflake within one millisecond. 0-1023.
SNOWFLAKE_NODE_ID=0

# ---------------------------------------------------------------------------
# Object storage — MinIO locally, Cloudflare R2 in production
# ---------------------------------------------------------------------------
#
# Same S3 API either way, so promoting to R2 is these five lines and nothing
# else.

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_MEDIA_BUCKET=media
S3_DM_MEDIA_BUCKET=dm-media

# ---------------------------------------------------------------------------
# Realtime — shared by apps/api and apps/realtime
# ---------------------------------------------------------------------------
#
# REALTIME_TICKET_SECRET is the one secret both services hold. Django signs a
# 60-second HS256 ticket with it; the gateway verifies and never calls back.
# It lives only in the environment. Both processes must agree, or every socket
# is rejected with a 401.
#
# At least 32 bytes: HS256's security is bounded by the key, and PyJWT warns
# below that. Generate a real one with `openssl rand -hex 32`.

REALTIME_TICKET_SECRET=dev-only-insecure-ticket-secret-0123456789abcdef
REALTIME_PORT=4000
REALTIME_URL=ws://localhost:4000/ws

# ---------------------------------------------------------------------------
# Next.js — apps/web
# ---------------------------------------------------------------------------
#
# Where /api/* is rewritten to. This rewrite is the only integration point
# between the frontend and Django, and it is what keeps the session cookie
# same-origin.

API_ORIGIN=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
#
# Django 6.1 deprecates the EMAIL_* settings in favour of MAILERS. Console
# backend locally: password reset links print to the terminal.

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---------------------------------------------------------------------------
# Phase 7 — calls. Not read by anything yet.
# ---------------------------------------------------------------------------
#
# These match infra/livekit/livekit.yaml and infra/coturn/turnserver.conf.
# Both services sit behind the compose `calls` profile until Phase 7.

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_dev
